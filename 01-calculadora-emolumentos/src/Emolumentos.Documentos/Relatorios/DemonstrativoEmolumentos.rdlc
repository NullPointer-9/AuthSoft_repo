                </TextRuns>
                <Style /><SpaceAfter>6pt</SpaceAfter>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Custas: </Value>
                    <Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight></Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Parameters!Custas.Value</Value>
                    <Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize></Style>
                  </TextRun>
                </TextRuns>
                <Style /><SpaceAfter>6pt</SpaceAfter>
              </Paragraph>
            </Paragraphs>
            <Top>2cm</Top>
            <Left>0cm</Left>
            <Height>4.6cm</Height>
            <Width>17cm</Width>
