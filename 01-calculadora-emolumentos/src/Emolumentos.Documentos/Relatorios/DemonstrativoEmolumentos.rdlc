          <Textbox Name="txtRodape">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Emitido em " &amp; Parameters!DataEmissao.Value &amp; ". Documento assinado digitalmente por " &amp; Parameters!Assinante.Value &amp; "."</Value>
                    <Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize></Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Valores ilustrativos, para fins de demonstração. Consulte a tabela oficial publicada pelo Tribunal de Justiça da UF.</Value>
                    <Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontStyle>Italic</FontStyle><Color>#777777</Color></Style>
