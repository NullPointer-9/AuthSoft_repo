<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Banco do docker-compose deste projeto (porta 14331). -->
    <add name="Emolumentos"
         connectionString="Server=localhost,14331;Database=Emolumentos;User Id=sa;Password=Cartorio@2026;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!--
      Certificado usado para assinar os PDFs. Em produção seria um certificado ICP-Brasil (A1).
      Para demonstração, se o arquivo não existir, um certificado autoassinado de teste é criado nele.
    -->
    <add key="CertificadoPfx" value="%LOCALAPPDATA%\Emolumentos\certificado-teste.pfx" />
    <add key="CertificadoSenha" value="teste-portfolio" />
    <add key="CertificadoTitular" value="Cartorio de Teste - Portfolio" />
  </appSettings>
</configuration>
