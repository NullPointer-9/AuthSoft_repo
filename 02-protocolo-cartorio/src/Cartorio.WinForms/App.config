<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Banco do docker-compose deste projeto (porta 14332). -->
    <add name="CartorioContext"
         connectionString="Server=localhost,14332;Database=CartorioProtocolo;User Id=sa;Password=Cartorio@2026;TrustServerCertificate=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!--
      Certificado usado para assinar os comprovantes. Em produção seria um certificado ICP-Brasil (A1).
      Para demonstração, se o arquivo não existir, um certificado autoassinado de teste é criado nele.
    -->
    <add key="CertificadoPfx" value="%LOCALAPPDATA%\CartorioProtocolo\certificado-teste.pfx" />
    <add key="CertificadoSenha" value="teste-portfolio" />
    <add key="CertificadoTitular" value="Cartorio de Notas de Teste - Portfolio" />
  </appSettings>
</configuration>
