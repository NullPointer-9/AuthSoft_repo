<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Usadas quando a opção de conexão não é informada. O nome é o valor da opção de banco. -->
    <add name="sqlserver"
         connectionString="Server=localhost,14333;Database=MigracoesDemo;User Id=sa;Password=Cartorio@2026;TrustServerCertificate=True" />
    <add name="postgres"
         connectionString="Host=localhost;Port=54333;Database=migracoes_demo;Username=postgres;Password=Cartorio@2026" />
  </connectionStrings>
</configuration>
