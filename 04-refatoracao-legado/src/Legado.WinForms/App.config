<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <add name="LegadoCartorio"
         connectionString="Data Source=localhost,14334;Initial Catalog=LegadoCartorio;User ID=sa;Password=Cartorio@2026"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!--
      Certificado usado para assinar os recibos. Em produção seria um certificado ICP-Brasil (A1).
      Para demonstração, se o arquivo não existir, um certificado autoassinado de teste é criado nele.
    -->
    <add key="CertificadoPfx" value="%LOCALAPPDATA%\BalcaoCertidoes\certificado-teste.pfx" />
    <add key="CertificadoSenha" value="teste-portfolio" />
    <add key="CertificadoTitular" value="Balcao de Certidoes de Teste - Portfolio" />
  </appSettings>
</configuration>
